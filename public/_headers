# Cloudflare Pages and Netlify both read this file.
# COOP + COEP make the page cross-origin isolated, which unlocks SharedArrayBuffer
# and therefore multithreaded WASM inference. GitHub Pages cannot set these headers.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache
